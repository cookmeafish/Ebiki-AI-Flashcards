{
  "name": "ebiki",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "// main": "Electron's own fallback for a bare, argument-less launch (e.g. a naive taskbar pin that only remembers the exe path, not its arguments) is to look for an app via THIS field - without it, that launch shows Electron's generic getting-started demo screen instead of Ebiki. electron/main.cjs treats a bare launch as the app window (its own default now); only --overlay switches modes.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "drive": "node .claude/skills/run-ebiki/drive.mjs",
    "overlay": "electron electron/main.cjs --overlay",
    "overlay:dev": "electron electron/main.cjs --overlay --dev",
    "app-window": "electron electron/main.cjs",
    "postinstall": "node scripts/brand-electron-exe.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "electron": "^33.4.11",
    "rcedit": "^5.0.2"
  }
}
